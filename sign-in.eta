<!doctype html>
<html lang="en">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@knadh/oat@0.6.1/oat.min.css"
      integrity="sha384-Og/V0L/W2NTx/MFghQT69RgjpXeYmxarXb64BwF/k92HSjxGWFo6GT1/weuT7qWA"
      crossorigin="anonymous"
    />
    <title>Sign In</title>
  </head>
  <body>
    <main class="container">
      <form method="post" action="/signin">
        <h1><%= it.title %></h1>
        <% if (it.error) { %>
        <p role="alert"><%= it.error %></p>
        <% } %>
        <input type="hidden" name="csrfToken" value="<%= it.csrfToken %>" />
        <label>
          Email
          <input type="email" name="email" value="<%= it.email %>" autocomplete="email" required />
        </label>
        <label>
          Password
          <input type="password" name="password" autocomplete="current-password" required />
        </label>
        <button type="submit">Sign In</button>
        <p><a href="/register">Register for account</a></p>
      </form>
    </main>
  </body>
</html>
