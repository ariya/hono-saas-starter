<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profile</title>
  <link rel="stylesheet" href="https://unpkg.com/@knadh/oat/oat.min.css">
</head>
<body>
  <header>
    <nav class="container">
      <ul>
        <li><strong><%= it.email %></strong></li>
      </ul>
      <ul>
        <li>
          <form action="/signout" method="POST" style="margin: 0;">
            <input type="hidden" name="_csrf" value="<%= it.csrfToken %>">
            <button type="submit" style="margin: 0; padding: 0.25rem 0.75rem;">Sign Out</button>
          </form>
        </li>
      </ul>
    </nav>
  </header>
  <main class="container">
    <section>
      <h2>Welcome Back!</h2>
      <p>This is your secure, authenticated SaaS profile dashboard. You can access all dashboard features from here.</p>
    </section>
  </main>
</body>
</html>
