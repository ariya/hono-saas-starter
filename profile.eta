<!doctype html>
<html lang="en">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@knadh/oat@0.6.1/oat.min.css"
      integrity="sha384-Og/V0L/W2NTx/MFghQT69RgjpXeYmxarXb64BwF/k92HSjxGWFo6GT1/weuT7qWA"
      crossorigin="anonymous"
    />
    <title>Profile</title>
  </head>
  <body>
    <nav class="container">
      <strong><%= it.user.email %></strong>
      <form method="post" action="/signout">
        <input type="hidden" name="csrfToken" value="<%= it.csrfToken %>" />
        <button type="submit">Sign Out</button>
      </form>
    </nav>
    <main class="container">
      <h1>Profile</h1>
    </main>
  </body>
</html>
