<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Profile</title>
<link rel="stylesheet" href="https://unpkg.com/@knadh/oat/oat.min.css">
</head>
<body>
<nav data-topnav>
<div class="row">
<div class="col-6"><strong><%= it.email %></strong></div>
<div class="col-6 justify-end hstack">
<form method="post" action="/signout">
<input type="hidden" name="csrf" value="<%= it.csrfToken %>">
<button type="submit" class="outline small">Sign Out</button>
</form>
</div>
</div>
</nav>
<main>
<article>
<h1>Profile</h1>
<p>Welcome to your dashboard.</p>
</article>
</main>
</body>
</html>
