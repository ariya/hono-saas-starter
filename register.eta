<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Register</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/oat.ink@latest/css/oat.css">
</head>
<body>
<main class="container">
  <h1>Create Account</h1>
  <% if (it.success) { %>
    <p><%= it.success %></p>
    <meta http-equiv="refresh" content="2;url=/">
  <% } %>
  <% if (it.error) { %>
    <p><%= it.error %></p>
  <% } %>
  <% if (!it.success) { %>
  <form action="/register" method="POST">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
    <label>Email <input type="email" name="email" required></label>
    <label>Password <input type="password" name="password" required minlength="8" pattern="(?=.*[A-Z])(?=.*[a-z])(?=.*\d).{8,}"></label>
    <button type="submit">Register</button>
  </form>
  <p><a href="/">Back to Sign In</a></p>
  <% } %>
</main>
</body>
</html>
