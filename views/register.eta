<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register</title>
  <link rel="stylesheet" href="https://unpkg.com/@knadh/oat/oat.min.css">
</head>
<body>
  <main style="max-width: 24rem; margin: 4rem auto; padding: 0 1rem;">
    <h1>Register for account</h1>
    <% if (it.error) { %>
    <div role="alert" class="alert"><%= it.error %></div>
    <% } %>
    <% if (it.success) { %>
    <div role="status" class="success"><%= it.success %></div>
    <% } %>
    <form method="post" action="/register">
      <input type="hidden" name="_csrf" value="<%= it.csrf %>">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" required autofocus>
      <label for="password">Password</label>
      <input type="password" id="password" name="password" minlength="8" required>
      <button type="submit">Register</button>
    </form>
    <p><a href="/">Back to sign in</a></p>
  </main>
</body>
</html>
