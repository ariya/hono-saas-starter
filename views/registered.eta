<% layout('./layout', { title: 'Registration received', refresh: '3;url=/' }) %>
<main class="container">
  <article class="card">
    <header>
      <h1>Registration received</h1>
    </header>
    <div role="alert" data-variant="success">
      <strong>Thanks!</strong> If <%= it.email %> was available, the account is ready to use.
    </div>
    <p>Redirecting you to the sign-in page. <a href="/">Continue now</a>.</p>
  </article>
</main>
