<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profile</title>
  <link rel="stylesheet" href="https://unpkg.com/@knadh/oat/oat.min.css">
</head>
<body>
  <nav style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1rem; border-bottom: 1px solid var(--muted-border-color);">
    <strong><%= it.email %></strong>
    <form method="post" action="/signout">
      <input type="hidden" name="_csrf" value="<%= it.csrf %>">
      <button type="submit">Sign Out</button>
    </form>
  </nav>
  <main style="max-width: 48rem; margin: 2rem auto; padding: 0 1rem;">
    <h1>Profile</h1>
    <p>Welcome to your profile.</p>
  </main>
</body>
</html>
