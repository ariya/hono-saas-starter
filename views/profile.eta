<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Profile</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/oat.ink" />
  </head>
  <body>
    <header>
      <nav>
        <span><%= it.email %></span>
        <form method="post" action="/signout">
          <input type="hidden" name="_csrf" value="<%= it.csrf %>" />
          <button type="submit">Sign Out</button>
        </form>
      </nav>
    </header>
    <main>
      <h1>Profile</h1>
    </main>
  </body>
</html>
