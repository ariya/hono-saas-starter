<% layout('./layout', { title: 'Profile' }) %>
<nav data-topnav>
  <div class="hstack justify-between w-100">
    <strong><%= it.email %></strong>
    <form method="post" action="/signout">
      <input type="hidden" name="csrf" value="<%= it.csrfToken %>" />
      <button type="submit" class="outline small">Sign out</button>
    </form>
  </div>
</nav>
<main class="container">
  <article class="card">
    <header>
      <h1>Your profile</h1>
      <p>Account details and settings will appear here.</p>
    </header>
    <p>You are signed in as <strong><%= it.email %></strong>.</p>
  </article>
</main>
